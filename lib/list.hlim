decl(length <list> {
    decl(i 0)
    loop(![list:i == nil] asn(i i+1))
    i+1
})

decl(find <list n> {
    decl(i 0)
    decl(found 0)
    loop(![list:i == nil] {
        if(list:i == n asn(found 1))
        asn(i i+1)
    }())
    found
})

decl(compare <Xs Ys> {
    decl(i 0)
    decl(diff 0)

    if(length(Xs) != length(Ys) 1
        {   loop(![Xs:i == nil] {
                if(Xs:i != Ys:i asn(diff 1))
                asn(i i+1)
            }())
            diff
        }()
    )
})

